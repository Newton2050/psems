<IfModule mod_rewrite.c>
    RewriteEngine On

    # If a directory or a file exists, use it directly
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d

    # Otherwise forward to index.php
    RewriteRule ^ index.php [L]
</IfModule>

# Protect .env files
<FilesMatch "^\.env">
    Require all denied
</FilesMatch>
