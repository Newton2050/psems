{
    "name": "psems/primary-school-exam-management-system",
    "description": "A comprehensive Primary School Examination Management System",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "ext-pdo": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-session": "*",
        "vlucas/phpdotenv": "^5.6",
        "monolog/monolog": "^3.5",
        "phpmailer/phpmailer": "^6.9"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "squizlabs/php_codesniffer": "^3.9"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "files": [
            "app/Helpers/functions.php"
        ]
    },
    "scripts": {
        "post-install-cmd": [
            "@php -r \"if (!is_dir('storage/logs')) { mkdir('storage/logs', 0755, true); }\"",
            "@php -r \"if (!is_dir('storage/cache')) { mkdir('storage/cache', 0755, true); }\""
        ],
        "dev": "php -S localhost:8080 -t public/"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
